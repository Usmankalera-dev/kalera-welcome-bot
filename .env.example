# Copy to .env for local testing. NEVER commit .env (see .gitignore).
# On Vercel, set these same values in the project Settings > Environment Variables.

# GitHub App ID (number shown on the app's settings page)
APP_ID=123456

# RSA private key of the GitHub App, as generated when the app was created.
# Paste the whole PEM. If it contains literal \n characters, the code converts
# them to real newlines — either form works.
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...paste the full key here...\n-----END RSA PRIVATE KEY-----"

# Webhook secret — must match the secret set on the GitHub App's settings page
WEBHOOK_SECRET=choose-a-long-random-secret

# Optional, for local tests only. Leave unset in production.
# GITHUB_API_BASE=https://api.github.com
